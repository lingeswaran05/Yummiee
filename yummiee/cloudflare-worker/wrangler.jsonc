{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yummiee-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yummiee-db",
      "database_id": "placeholder-yummiee-db-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "yummiee-images"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "*",
    "CLERK_SECRET_KEY": "test_secret_for_local_dev_only_change_in_prod"
  }
}
