# Cloudflare Worker Environment Variables
# For local dev, wrangler will automatically read from .dev.vars (optional)

# Clerk Configuration (optional for offline mode, recommended for JWT signature verification)
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_ISSUER=https://clerk.your-domain.com

# CORS Configuration
ALLOWED_ORIGIN=*
